# Database Credentials (used by prod profile and docker-compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=

# JWT Configuration (RS256 — PEM-encoded RSA key pair)
# In dev/test profiles, keys are auto-generated if not set.
# In prod, both MUST be set. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform PEM
#   openssl rsa -pubout
PERMISSIO_JWT_PRIVATE_KEY=
PERMISSIO_JWT_PUBLIC_KEY=

# API Key Hashing
PERMISSIO_API_KEY_SALT=

# Active Spring Profile (dev = H2, prod = PostgreSQL)
SPRING_PROFILES_ACTIVE=dev
